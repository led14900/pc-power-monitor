<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PcPowerMonitor.App.Converters">

    <!-- Converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullableDoubleToDisplayConverter x:Key="NullableDouble" />
    <conv:QualityToTextConverter x:Key="QualityText" />
    <conv:VndCurrencyConverter x:Key="Vnd" />
    <conv:MonthDeltaConverter x:Key="MonthDelta" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />

    <!-- Palette -->
    <Color x:Key="AccentColor">#2F6FED</Color>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
    <SolidColorBrush x:Key="TrackBrush" Color="#EBEEF3" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="GoodBrush" Color="#178A5A" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#EEF3FF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#FEF6E7" />

    <!-- Typography -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="MetricCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="MetricValueLarge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="MetricUnit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DegradedBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="16,16,16,0" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="RangeButton" TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

</ResourceDictionary>
