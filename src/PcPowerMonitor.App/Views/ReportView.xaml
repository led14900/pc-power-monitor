<UserControl x:Class="PcPowerMonitor.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PcPowerMonitor.App.Views"
             Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <ComboBox Width="100" DockPanel.Dock="Left"
                      ItemsSource="{Binding AvailableYears}"
                      SelectedItem="{Binding SelectedYear, Mode=TwoWay}" />

            <TextBlock Text="Đang tải…" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Xuất CSV" Style="{StaticResource RangeButton}"
                        Command="{Binding ExportCsvCommand}" />
                <Button Content="Xuất ảnh biểu đồ" Style="{StaticResource RangeButton}"
                        Command="{Binding ExportChartPngCommand}" />
                <Button Content="Tính lại lịch sử" Style="{StaticResource RangeButton}"
                        Command="{Binding RecalculateHistoryCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Stale-tariff banner -->
        <Border Grid.Row="1" Style="{StaticResource WarningBanner}"
                Visibility="{Binding HasTariffWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding TariffWarning}" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{StaticResource WarningBrush}" />
        </Border>

        <!-- Month table -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{StaticResource CardBackgroundBrush}" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tháng" Binding="{Binding MonthLabel}" Width="90" />
                <DataGridTextColumn Header="kWh" Width="90"
                                    Binding="{Binding Kwh, StringFormat={}{0:N2}}" />
                <DataGridTextColumn Header="Tiền chưa VAT (đ)" Width="150"
                                    Binding="{Binding SubtotalVnd, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Header="VAT (đ)" Width="110"
                                    Binding="{Binding VatVnd, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Header="Tổng (đ)" Width="130"
                                    Binding="{Binding TotalVnd, StringFormat={}{0:N0}}" />
                <DataGridTextColumn Header="Giờ chạy" Width="90"
                                    Binding="{Binding UptimeHours, StringFormat={}{0:N1}}" />
                <DataGridTemplateColumn Header="So tháng trước" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="6,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource MonthDelta}">
                                        <Binding Path="DeltaPercent" />
                                        <Binding Path="DeltaVnd" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Year totals + chart -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="8">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="4,2,4,6">
                    <TextBlock Style="{StaticResource MetricCaption}" Margin="0,0,16,0">
                        <Run Text="Tổng năm:" />
                        <Run Text="{Binding TotalKwh, StringFormat={}{0:N2} kWh, Mode=OneWay}"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MetricCaption}" Margin="0,0,16,0">
                        <Run Text="Tổng tiền:" />
                        <Run Text="{Binding TotalCostVnd, StringFormat={}{0:N0} đ, Mode=OneWay}"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MetricCaption}">
                        <Run Text="Giờ chạy:" />
                        <Run Text="{Binding TotalUptimeHours, StringFormat={}{0:N1} h, Mode=OneWay}"
                             FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </WrapPanel>
                <views:ReportChartView x:Name="Chart" />
            </DockPanel>
        </Border>

        <!-- Estimate disclaimer -->
        <TextBlock Grid.Row="4" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Style="{StaticResource MetricCaption}"
                   ToolTip="Mô hình flat bậc 6: mỗi kWh PC dùng thêm tính đúng giá bậc 6 (chi phí biên), không lũy tiến 6 bậc." />
    </Grid>
</UserControl>
