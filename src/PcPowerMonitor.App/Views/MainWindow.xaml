<Window x:Class="PcPowerMonitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PcPowerMonitor.App.Views"
        Title="PC Power Monitor" Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DegradedBanner}"
                Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Xem hướng dẫn" Padding="12,4"
                        VerticalAlignment="Center" Command="{Binding OpenGuideCommand}" />
                <TextBlock Text="{Binding DegradedMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}" />
            </DockPanel>
        </Border>

        <TabControl Margin="8" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Tổng quan">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="Phần cứng">
                <views:HardwareView DataContext="{Binding Hardware}" />
            </TabItem>
            <TabItem Header="Báo cáo">
                <views:ReportView DataContext="{Binding Report}" />
            </TabItem>
            <TabItem Header="Cài đặt">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
