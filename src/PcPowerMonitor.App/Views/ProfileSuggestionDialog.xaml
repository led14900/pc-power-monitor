<Window x:Class="PcPowerMonitor.App.Views.ProfileSuggestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết quả tra cứu AI" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ErrorBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error banner: shown only when JSON parsing failed -->
        <Border Grid.Row="0" Style="{StaticResource ErrorBannerStyle}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrush}" />
        </Border>

        <!-- Diff table -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Fields}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="360"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trường" Binding="{Binding DisplayName}" Width="160" />
                <DataGridTextColumn Header="Hiện tại" Binding="{Binding CurrentValue}" Width="*" />
                <DataGridTextColumn Header="Đề xuất" Binding="{Binding SuggestedValue}" Width="*" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Changed}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Raw response expander -->
        <Expander Grid.Row="2" Header="Xem phản hồi AI gốc" Margin="0,10,0,0" IsExpanded="False">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding RawResponse, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0"
                         Background="Transparent" />
            </ScrollViewer>
        </Expander>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Áp dụng" Width="90" Margin="0,0,8,0" Style="{StaticResource RangeButton}"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click" />
            <Button Content="Hủy" Width="90" Style="{StaticResource RangeButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
