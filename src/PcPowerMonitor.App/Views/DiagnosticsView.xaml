<UserControl x:Class="PcPowerMonitor.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource MetricCaption}">
            <Run Text="Trạng thái cảm biến:" />
            <Run Text="{Binding Availability, Mode=OneWay}" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}" />
        </TextBlock>

        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,4,0,0"
                   Text="{Binding AvailabilityReason}" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,4,0,0">
            <Run Text="Thư mục log:" />
            <Run Text="{Binding LogFolderPath, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
        </TextBlock>

        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,4,0,0">
            <Run Text="Dung lượng CSDL:" />
            <Run Text="{Binding DatabaseSizeMb, StringFormat={}{0:N2} MB, Mode=OneWay}"
                 Foreground="{StaticResource TextBrush}" />
        </TextBlock>

        <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="8" MinWidth="0">
            <ListBox ItemsSource="{Binding DiagnosticLines}" Height="180"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Làm mới" Style="{StaticResource RangeButton}"
                    Command="{Binding RefreshCommand}" />
            <Button Content="Sao chép chẩn đoán" Style="{StaticResource RangeButton}"
                    Command="{Binding CopyDiagnosticsCommand}" />
            <Button Content="Mở thư mục log" Style="{StaticResource RangeButton}"
                    Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>

        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Chẩn đoán có thể chứa tên phần cứng của bạn — cân nhắc trước khi chia sẻ công khai." />
    </StackPanel>
</UserControl>
