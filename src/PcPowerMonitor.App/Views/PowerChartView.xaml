<UserControl x:Class="PcPowerMonitor.App.Views.PowerChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:vm="clr-namespace:PcPowerMonitor.App.ViewModels">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel.Resources>
                <!-- Highlights whichever range button matches the ViewModel's current Range,
                     so a click gives clear visual feedback even when the plotted line barely
                     changes (e.g. only a few hours of history collected so far). -->
                <Style x:Key="RangeButtonLastHour" TargetType="Button" BasedOn="{StaticResource RangeButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Range}" Value="{x:Static vm:ChartRange.LastHour}">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="RangeButtonLast24Hours" TargetType="Button" BasedOn="{StaticResource RangeButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Range}" Value="{x:Static vm:ChartRange.Last24Hours}">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="RangeButtonLast7Days" TargetType="Button" BasedOn="{StaticResource RangeButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Range}" Value="{x:Static vm:ChartRange.Last7Days}">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>

            <Button Content="1 giờ" Style="{StaticResource RangeButtonLastHour}"
                    Command="{Binding SetRangeCommand}"
                    CommandParameter="{x:Static vm:ChartRange.LastHour}" />
            <Button Content="24 giờ" Style="{StaticResource RangeButtonLast24Hours}"
                    Command="{Binding SetRangeCommand}"
                    CommandParameter="{x:Static vm:ChartRange.Last24Hours}" />
            <Button Content="7 ngày" Style="{StaticResource RangeButtonLast7Days}"
                    Command="{Binding SetRangeCommand}"
                    CommandParameter="{x:Static vm:ChartRange.Last7Days}" />
            <TextBlock Text="Đang tải dữ liệu…" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <wpf:WpfPlot x:Name="Plot" Grid.Row="1" />
    </Grid>
</UserControl>
