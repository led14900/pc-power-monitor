<UserControl x:Class="PcPowerMonitor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PcPowerMonitor.App.Views"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource MetricCaption}" Text="{Binding StatusMessage}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Khôi phục mặc định" Style="{StaticResource RangeButton}"
                            Command="{Binding ResetDefaultsCommand}" />
                    <Button Content="Lưu" Style="{StaticResource RangeButton}" MinWidth="90"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Lấy mẫu -->
                <Expander Header="Lấy mẫu">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Khoảng lấy mẫu (giây, 1–60)" />
                        <TextBox Text="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Expander>

                <!-- Cấu hình AI (Vertex AI — nhà cung cấp AI duy nhất) -->
                <Expander Header="Cấu hình AI" DataContext="{Binding Ai}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Service Account" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Chọn file JSON" Style="{StaticResource RangeButton}"
                                    Command="{Binding PickServiceAccountCommand}" />
                            <Button Content="Xóa" Style="{StaticResource RangeButton}" Margin="8,0,0,0"
                                    Command="{Binding ClearServiceAccountCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasValidServiceAccount, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource GoodBrush}">
                            <Run Text="✓ " /><Run Text="{Binding ServiceAccountEmail, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ServiceAccountEmail, Mode=OneWay}"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding HasServiceAccountError, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Project ID" />
                        <TextBox Text="{Binding ProjectId, UpdateSourceTrigger=LostFocus}" MinWidth="220"
                                 HorizontalAlignment="Left"
                                 ToolTip="Tự động điền từ file Service Account JSON khi chọn file" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Region" />
                        <TextBox Text="{Binding Region, UpdateSourceTrigger=LostFocus}" MinWidth="220"
                                 HorizontalAlignment="Left"
                                 ToolTip="VD: us-central1, europe-west1" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Model ID" />
                        <TextBox Text="{Binding ModelId, UpdateSourceTrigger=LostFocus}" MinWidth="220"
                                 HorizontalAlignment="Left" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Model máy (tùy chọn)" />
                        <TextBox Text="{Binding MachineModel, UpdateSourceTrigger=LostFocus}" MinWidth="220"
                                 HorizontalAlignment="Left"
                                 ToolTip="VD: Lenovo ThinkCentre M700 Tiny — giúp AI đoán chính xác hơn" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Loại máy" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="AiDeviceType" Margin="0,0,16,0" Content="Máy để bàn (Desktop)"
                                         IsChecked="{Binding DeviceType, Converter={StaticResource EnumToBool},
                                                     ConverterParameter=Desktop}" />
                            <RadioButton GroupName="AiDeviceType" Content="Máy laptop"
                                         IsChecked="{Binding DeviceType, Converter={StaticResource EnumToBool},
                                                     ConverterParameter=Laptop}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Cấu hình phần cứng -->
                <Expander Header="Cấu hình phần cứng" DataContext="{Binding Hardware}">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TDP CPU (W)" />
                                <TextBox Text="{Binding CpuTdpW, UpdateSourceTrigger=LostFocus}" MinWidth="120" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TDP GPU (W, 0 nếu không có)" />
                                <TextBox Text="{Binding GpuTdpW, UpdateSourceTrigger=LostFocus}" MinWidth="120" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Số thanh RAM" />
                                <TextBox Text="{Binding RamSticks, UpdateSourceTrigger=LostFocus}" MinWidth="80" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Loại RAM" />
                                <ComboBox ItemsSource="{Binding RamTypeOptions}"
                                          SelectedItem="{Binding RamType}" MinWidth="100" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Số SSD" />
                                <TextBox Text="{Binding SsdCount, UpdateSourceTrigger=LostFocus}" MinWidth="80" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Số HDD" />
                                <TextBox Text="{Binding HddCount, UpdateSourceTrigger=LostFocus}" MinWidth="80" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Số quạt" />
                                <TextBox Text="{Binding FanCount, UpdateSourceTrigger=LostFocus}" MinWidth="80" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Watt mainboard" />
                                <TextBox Text="{Binding MotherboardW, UpdateSourceTrigger=LostFocus}" MinWidth="100" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Watt ngoại vi" />
                                <TextBox Text="{Binding PeripheralW, UpdateSourceTrigger=LostFocus}" MinWidth="100" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Công suất PSU (W)" />
                                <TextBox Text="{Binding PsuWattage, UpdateSourceTrigger=LostFocus}" MinWidth="100" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Chuẩn 80 PLUS" />
                                <ComboBox ItemsSource="{Binding PsuRatingOptions}"
                                          SelectedItem="{Binding PsuRating}" MinWidth="120" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,10,0,0">
                            <Run Text="Ước tính công suất nền (không gồm CPU/GPU):" />
                            <Run Text="{Binding BaselinePreviewW, StringFormat={}{0:N1} W, Mode=OneWay}"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,4,0,0"
                                   Text="v1 không tính điện màn hình." />

                        <Button Content="Dò thông số bằng AI"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding LookupWithAiCommand}"
                                IsEnabled="{Binding IsLookupEnabled}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Cần cấu hình Vertex AI hợp lệ trong mục 'Cấu hình AI' trước khi dùng tính năng này.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLookupBusy}" Value="True">
                                            <Setter Property="Content" Value="Đang tra cứu..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ErrorMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- Giá điện -->
                <Expander Header="Giá điện" DataContext="{Binding Tariff}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Đơn giá (đ/kWh, chưa VAT)" />
                        <TextBox Text="{Binding UnitPriceVnd, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="VAT (%)" />
                        <TextBox Text="{Binding VatPercent, UpdateSourceTrigger=LostFocus}" />
                        <CheckBox Content="Tính VAT vào chi phí" Margin="0,8,0,0"
                                  IsChecked="{Binding IncludeVat}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ngày hiệu lực" />
                        <DatePicker SelectedDate="{Binding EffectiveFrom}" MaxWidth="220" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ghi chú nguồn" />
                        <TextBox Text="{Binding SourceNote, UpdateSourceTrigger=LostFocus}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MaxWidth="520" MinHeight="48" />
                    </StackPanel>
                </Expander>

                <!-- Lưu trữ -->
                <Expander Header="Lưu trữ">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Số ngày giữ dữ liệu thô (1–365)" />
                        <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource MetricCaption}" Margin="0,8,0,0">
                            <Run Text="Dung lượng CSDL hiện tại:" />
                            <Run Text="{Binding DbSizeMb, StringFormat={}{0:N2} MB, Mode=OneWay}"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Dọn dẹp ngay" Style="{StaticResource RangeButton}"
                                    Command="{Binding CleanupNowCommand}" />
                            <Button Content="Mở thư mục dữ liệu" Style="{StaticResource RangeButton}"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Khởi động -->
                <Expander Header="Khởi động">
                    <StackPanel>
                        <CheckBox Content="Khởi động cùng Windows" IsChecked="{Binding AutoStartEnabled}" />
                        <CheckBox Content="Khởi động thu nhỏ xuống khay hệ thống" Margin="0,8,0,0"
                                  IsChecked="{Binding StartMinimized}" />
                    </StackPanel>
                </Expander>

                <!-- Cảnh báo -->
                <Expander Header="Cảnh báo">
                    <StackPanel>
                        <CheckBox Content="Bật cảnh báo ngưỡng" IsChecked="{Binding AlertsEnabled}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ngưỡng nhiệt CPU (°C, 40–110)" />
                        <TextBox Text="{Binding CpuTempC, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ngưỡng nhiệt GPU (°C, 40–110)" />
                        <TextBox Text="{Binding GpuTempC, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ngưỡng công suất (W, 50–2000)" />
                        <TextBox Text="{Binding PowerW, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thời gian chờ giữa 2 cảnh báo (phút, 1–240)" />
                        <TextBox Text="{Binding CooldownMinutes, UpdateSourceTrigger=LostFocus}" />
                        <Button Content="Thử thông báo" Style="{StaticResource RangeButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Command="{Binding TestNotificationCommand}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nhật ký cảnh báo gần đây" />
                        <Border Style="{StaticResource CardBorder}" Padding="6" MinWidth="0">
                            <ListBox ItemsSource="{Binding AlertLog}" Height="150"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding TimestampUtc, StringFormat=HH:mm, Mode=OneWay}"
                                                 Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="{Binding Kind, Mode=OneWay}"
                                                 Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Chẩn đoán -->
                <Expander Header="Chẩn đoán">
                    <views:DiagnosticsView DataContext="{Binding Diagnostics}" />
                </Expander>

                <!-- Giới thiệu -->
                <Expander Header="Giới thiệu">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricCaption}" TextWrapping="Wrap"
                                   Text="Phiên bản, giấy phép thư viện bên thứ ba và liên kết mã nguồn LibreHardwareMonitor." />
                        <Button Content="Giới thiệu" Style="{StaticResource RangeButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenAboutCommand}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
