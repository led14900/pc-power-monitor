<Project>
  <!-- Shared build settings for all PcPowerMonitor projects. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LHM + WinRing0 driver require a 64-bit process; force x64 codegen. -->
    <PlatformTarget>x64</PlatformTarget>
    <Company>PC Power Monitor</Company>
    <Product>PC Power Monitor</Product>
    <Copyright>PC Power Monitor</Copyright>
  </PropertyGroup>

  <!-- The project tree lives on a Google Drive virtual filesystem which keeps
       memory-mapped sections open on output files (breaks the SDK's CreateAppHost
       resource rewrite). Redirect all build intermediates/outputs to local disk. -->
  <PropertyGroup>
    <_PcpmBuildRoot>$(LOCALAPPDATA)\pcpm-build</_PcpmBuildRoot>
    <BaseIntermediateOutputPath>$(_PcpmBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(_PcpmBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
